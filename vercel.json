{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-dashboard": {
      "root": "admin-dashboard",
      "framework": "vite"
    },
    "radha-swami-backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install"
    },
    "customer-frontend": {
      "root": "customer-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "radha-swami-backend"
      }
    }
  ]
