{
  "version": 2,
  "buildCommand": "npm install --prefix customer-frontend && npm install --prefix admin-dashboard && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "lib/**"
    },
    "uploads/**/*.js": {
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/uploads/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/((?!api/|uploads/|admin/).*)", "destination": "/index.html" }
  ]
}
